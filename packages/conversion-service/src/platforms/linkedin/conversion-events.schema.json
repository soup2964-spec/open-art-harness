{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openart-signal.example/conversion-service/linkedin/conversion-events.schema.json",
  "title": "LinkedIn Conversions API: POST https://api.linkedin.com/rest/conversionEvents (X-RestLi-Method: BATCH_CREATE)",
  "description": "Transcribed from learn.microsoft.com/en-us/linkedin/marketing/integrations/ads-reporting/conversions-api and conversions-api-schema (view=li-lms-2026-09, fetched 2026-09-29). Headers Linkedin-Version: 202609, X-Restli-Protocol-Version: 2.0.0, X-RestLi-Method: BATCH_CREATE; Authorization added by the live transport.",
  "type": "object",
  "additionalProperties": false,
  "required": ["elements"],
  "properties": {
    "elements": {
      "description": "'up to 5,000 conversion events in a single batch request'",
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": { "$ref": "#/$defs/ConversionEvent" }
    }
  },
  "$defs": {
    "ConversionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversion", "conversionHappenedAt", "user"],
      "properties": {
        "conversion": { "type": "string", "pattern": "^urn:lla:llaPartnerConversion:[0-9]+$" },
        "conversionHappenedAt": { "description": "'Epoch timestamp in milliseconds' within the past 90 days.", "type": "integer", "minimum": 1000000000000, "maximum": 99999999999999 },
        "conversionValue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["currencyCode", "amount"],
          "properties": {
            "currencyCode": { "type": "string", "pattern": "^[A-Z]{3}$" },
            "amount": { "description": "'decimal string. (e.g. \"100.05\")'", "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }
          }
        },
        "eventId": { "description": "'used for deduplication'", "type": "string", "minLength": 1 },
        "user": {
          "type": "object",
          "additionalProperties": false,
          "required": ["userIds"],
          "properties": {
            "userIds": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["idType", "idValue"],
                "properties": {
                  "idType": { "enum": ["SHA256_EMAIL", "LINKEDIN_FIRST_PARTY_ADS_TRACKING_UUID", "ACXIOM_ID", "PLAINTEXT_IP_ADDRESS", "SHA256_IP_ADDRESS", "GOOGLE_AID"] },
                  "idValue": { "type": "string", "minLength": 1 }
                },
                "allOf": [
                  {
                    "if": { "properties": { "idType": { "const": "SHA256_EMAIL" } } },
                    "then": { "properties": { "idValue": { "pattern": "^[0-9a-f]{64}$" } } }
                  },
                  {
                    "if": { "properties": { "idType": { "const": "PLAINTEXT_IP_ADDRESS" } } },
                    "then": { "properties": { "idValue": { "description": "'only IPv4 addresses are supported'", "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$" } } }
                  }
                ]
              }
            },
            "externalIds": { "description": "'The maximum supported size of the list is 1'", "type": "array", "maxItems": 1, "items": { "type": "string", "minLength": 1 } }
          }
        }
      }
    }
  }
}
